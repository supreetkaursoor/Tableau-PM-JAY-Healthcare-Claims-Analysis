      <column caption='FRAUD RATE' datatype='real' name='[Calculation_0320805894037511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0320805893271558]/[Calculation_1143515297697800]' />
      </column>
      <column caption='HIGHEST CLAIM' datatype='integer' name='[Calculation_0320805895213064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Claim_Amount])' />
      </column>
      <column caption='LOWEST CLAIM' datatype='integer' name='[Calculation_0320805895417865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Claim_Amount])' />
      </column>
      <column caption='kpi selection' datatype='real' name='[Calculation_0320805898530829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case ([Parameters].[Parameter 0320805896052747])&#13;&#10;when &quot;number of pending claims&quot; then COUNT(if [Claim_Status]=&quot;pending&quot; then [Claim_ID] END)&#13;&#10;when &quot;total claim amount&quot; then sum([Claim_Amount])&#13;&#10;when &quot;total approved amount&quot; then sum([Approved_Amount])&#13;&#10;when &quot;approval rate&quot; then count(if([Claim_Status])=&quot;approved&quot; then [Claim_ID] end)/count([Claim_ID])&#13;&#10;when &quot;rejection rate&quot; then count(IF ([Claim_Status])=&quot;rejected&quot; then [Claim_ID] end)/count([Claim_ID])&#13;&#10;when &quot;average claim amount&quot; then AVG([Claim_Amount])&#13;&#10;when &quot;average settlement days&quot; then AVG([Settlement_Days])&#13;&#10;when &quot;average length of stay&quot; then AVG([Length_of_Stay])&#13;&#10;when &quot;total number of claims&quot; then COUNT([Claim_ID])&#13;&#10;when &quot;number of approved claims&quot; then count(if([Claim_Status])=&quot;approved&quot; then [Claim_ID]END)&#13;&#10;when &quot;fraud rate&quot; then count(if([Fraud_Flag])=&quot;yes&quot; then [Claim_ID] end)/count([Claim_ID])&#13;&#10;when &quot;highest claim&quot; then MAX([Claim_Amount])&#13;&#10;when &quot;lowest claim&quot; then MIN([Claim_Amount])&#13;&#10;when &quot;total number of claims&quot; then COUNT([Claim_ID])&#13;&#10;when &quot;number of rejected claims&quot; then count(if([Claim_Status])=&quot;rejected&quot; then [Claim_ID] END)&#13;&#10;END' />
      </column>
      <column caption='topn claim amount filter' datatype='boolean' name='[Calculation_0320806020501520]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Claim_Amount]),&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='NOT FRAUD COUNT' datatype='integer' name='[Calculation_0660830595641344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF([Fraud_Flag])=&quot;No&quot; then [Claim_ID]&#13;&#10;END)' />
      </column>
      <column caption='topn (average length of stay) ' datatype='boolean' name='[Calculation_0893927164960770]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(AVG([Length_of_Stay]),&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='topn (approval rate)' datatype='boolean' name='[Calculation_0893927168667651]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_0320805891792897],&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='topn (fraud count)' datatype='boolean' name='[Calculation_0893927172923397]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_0320805893271558],&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='topn (approved amount)' datatype='boolean' name='[Calculation_0893927176724487]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE(sum([Approved_Amount]),&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='age group' datatype='string' name='[Calculation_1143515184386048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Age])&gt;=1 and [Age]&lt;=12 then &quot;child&quot;&#13;&#10;ELSEIF ([Age])&gt;=13 and [Age]&lt;=19 then &quot;teenager&quot;&#13;&#10;ELSEIF ([Age])&gt;=20 and [Age]&lt;= 35 then &quot;young adult&quot;&#13;&#10;ELSEIF ([Age])&gt;=36 and [Age]&lt;= 59 then &quot;middle age adult&quot;&#13;&#10;ELSE &quot;senior citizen&quot;&#13;&#10;END' />
      </column>
      <column caption='length of stay classification' datatype='string' name='[Calculation_1143515186593793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Length_of_Stay])&lt;=1 and [Length_of_Stay]&lt;=3 then &quot;short stay&quot;&#13;&#10;elseif ([Length_of_Stay])&gt;=4 and [Length_of_Stay]&lt;=7 then &quot;medium stay&quot;&#13;&#10;ELSE &quot;long stay&quot;&#13;&#10;END' />
      </column>
      <column caption='claim month/quarter/year' datatype='string' name='[Calculation_1143515260841987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Discharge_Date])+ &quot; &quot;+ &quot;Q&quot; +&#13;&#10;STR(DATEPART(&apos;quarter&apos;,[Discharge_Date]))+&quot; &quot;+&#13;&#10;STR(DATEPART(&apos;year&apos;,[Discharge_Date]))' />
      </column>
      <column caption='approval%' datatype='real' default-format='p0.0%' name='[Calculation_1143515264950276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Approved_Amount])/SUM([Claim_Amount])' />
      </column>
      <column caption='rejection%' datatype='real' default-format='p0.0%' name='[Calculation_1143515265560581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Rejected_Amount])/SUM([Claim_Amount])' />
      </column>
      <column caption='high claim amount' datatype='string' name='[Calculation_1143515267231750]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Claim_Amount])&gt;=100000 then &quot;high claim amount&quot;&#13;&#10;ELSE &quot;regular claim amount&quot;&#13;&#10;END' />
      </column>
      <column caption='settlement category' datatype='string' name='[Calculation_1143515269173255]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Settlement_Days])&gt;=0 and ([Settlement_Days])&lt;=7 then &quot;fast settlement&quot;&#13;&#10;elseif ([Settlement_Days])&gt;=8 and [Settlement_Days]&lt;=15 then &quot;moderate settlement&quot;&#13;&#10;elseif ([Settlement_Days])&gt;=16 and [Settlement_Days]&lt;=30 then &quot;slow settlement&quot;&#13;&#10;else &quot;delayed settlement&quot;&#13;&#10;END' />
      </column>
