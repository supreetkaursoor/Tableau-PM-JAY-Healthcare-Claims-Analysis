            <column caption='age group' datatype='string' name='[Calculation_1143515184386048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Age])&gt;=1 and [Age]&lt;=12 then &quot;child&quot;&#13;&#10;ELSEIF ([Age])&gt;=13 and [Age]&lt;=19 then &quot;teenager&quot;&#13;&#10;ELSEIF ([Age])&gt;=20 and [Age]&lt;= 35 then &quot;young adult&quot;&#13;&#10;ELSEIF ([Age])&gt;=36 and [Age]&lt;= 59 then &quot;middle age adult&quot;&#13;&#10;ELSE &quot;senior citizen&quot;&#13;&#10;END' />
