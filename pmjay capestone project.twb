        <zone forceUpdate='true' h='51000' id='95' type-v2='text' w='15872' x='82619' y='18800'>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>The dashboard provides an overview of </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Total Claims</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Total Claim Amount</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, and the distribution of </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Approved</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Rejected</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, and </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Pending</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> claims.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>May</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> recorded the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>highest number of claims</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, while </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>September</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> had the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>lowest number of claims</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> during the analysis period</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>(2024-2026).</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Tamil Nadu</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> reported the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>highest number of claims</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> among all states.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>The peak claim count reached </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>2,126 claims</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, corresponding to a </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>total claim amount of approximately 240K</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>West Bengal</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> recorded the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>highest claim amount</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>, whereas </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>Odisha</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> had the </run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'>lowest claim amount</run>
            <run fontcolor='#ffffff' fontname='Tableau Medium' fontsize='10'> across the states.</run>
          </formatted-text>
        </zone>
