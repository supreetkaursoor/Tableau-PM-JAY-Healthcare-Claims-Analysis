  <worksheets>
    <worksheet name='AVERAGE LENGTH OF STAY BY HOSPITAL'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='18'>AVERAGE LENGTH OF STAY BY HOSPITAL</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PMJAY_Claims_Dataset_50000 (PMJAY data)' name='federated.1jsaujx1js1zzq111lixo1foi2vq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption=' topn' datatype='integer' name='[Parameter 0320805919653902]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='10' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jsaujx1js1zzq111lixo1foi2vq'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='AVERAGE LENGTH OF STAY' datatype='real' name='[Calculation_0320805893021701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Length_of_Stay])' />
            </column>
            <column caption='topn (average length of stay) ' datatype='boolean' name='[Calculation_0893927164960770]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RANK_DENSE(AVG([Length_of_Stay]),&apos;desc&apos;)&lt;=[Parameters].[Parameter 0320805919653902]'>
                <table-calc ordering-type='Rows' />
